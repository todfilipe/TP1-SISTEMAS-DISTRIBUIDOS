# .env.example — copia este ficheiro para ".env" e ajusta os valores.
# O ".env" é ignorado pelo Git (ver .gitignore) para não expor credenciais.

# ─── URLs dos serviços gRPC ───────────────────────────────────
# Usadas pelos clientes C# (Gateway e Servidor).
# Em execução local: localhost. Dentro do Docker Compose, usar os
# nomes de serviço (preprocessing / analysis) como hostname.
PREPROCESSING_SERVICE_URL=http://localhost:50051
ANALYSIS_SERVICE_URL=http://localhost:50052
ENVIRONMENT_SERVICE_URL=http://environment:8001

# ─── RabbitMQ (Fase 2) ────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_VHOST=onehealth
RABBITMQ_EXCHANGE=sensors.exchange

# Sensor Node.js executado dentro do Docker Compose.
SENSOR_NODE_ID=ZC01
SENSOR_NODE_ZONE=ZONA_CENTRO
SENSOR_NODE_TYPE=TEMP,HUM,RUIDO,LUZ,PM2.5,PM10,AR
SENSOR_NODE_INTERVAL_SECONDS=5
SENSOR_NODE_PAYLOAD_FORMAT=JSON
SENSOR_NODE_RABBIT_HOST=rabbitmq
SENSOR_NODE_RABBIT_PORT=5672
SENSOR_NODE_RABBIT_USER=admin
SENSOR_NODE_RABBIT_PASS=admin
SENSOR_NODE_RABBIT_VHOST=onehealth

# Sensor C# original executado dentro do Docker Compose.
SENSOR_CSHARP_ID=ZC99
SENSOR_CSHARP_ZONE=ZONA_CENTRO
SENSOR_CSHARP_TYPE=PM2.5,PM10,AR
SENSOR_CSHARP_INTERVAL_SECONDS=5
SENSOR_CSHARP_PAYLOAD_FORMAT=JSON
SENSOR_CSHARP_RABBIT_HOST=rabbitmq
SENSOR_CSHARP_RABBIT_PORT=5672
SENSOR_CSHARP_RABBIT_USER=admin
SENSOR_CSHARP_RABBIT_PASS=admin
SENSOR_CSHARP_RABBIT_VHOST=onehealth

# ─── MongoDB (Fase 3) ───────────────────────────────────────
# Configuracao usada pelo docker-compose e pelos componentes da Fase 3.
MONGODB_ROOT_USERNAME=admin
MONGODB_ROOT_PASSWORD=admin
MONGODB_DATABASE=urbanodb

# Usado por componentes executados fora do Docker Compose.
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_AUTH_SOURCE=admin
MONGODB_URI=mongodb://admin:admin@localhost:27017/urbanodb?authSource=admin

# Usado pelo Mongo Express em http://localhost:8081.
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=admin
