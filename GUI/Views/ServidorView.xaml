<UserControl x:Class="OneHealthMonitor.Views.ServidorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgApp}">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ TOP BAR ═══════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="SERVIDOR — PORT " FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                <TextBox x:Name="PortHeader" Text="9090" Style="{StaticResource InputBox}"
                         FontSize="16" FontWeight="Bold" Foreground="{StaticResource Accent}"
                         Width="100" VerticalAlignment="Center"/>
                <Border x:Name="SrvStatusBadge" Background="{StaticResource Danger}" CornerRadius="10"
                        Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SrvStatusText" Text="STOPPED" FontSize="11" 
                                   FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnStartStop" Content="▶  START" Style="{StaticResource PrimaryButton}"
                        Click="BtnStartStop_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnStop" Content="⏹  STOP" Style="{StaticResource DangerButton}"
                        Click="BtnStop_Click" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>

        <!-- ═══════════ STATS CARDS ═══════════ -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Accent}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="AVG TEMP" FontSize="10" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextSecondary}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="AvgTempText" Text="--" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text=" °C" FontSize="14" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Accent}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="AVG PM2.5" FontSize="10" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextSecondary}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="AvgPmText" Text="--" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text=" µg" FontSize="14" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Accent}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="PEAK RUIDO" FontSize="10" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextSecondary}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="PeakRuidoText" Text="--" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text=" dB" FontSize="14" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Accent}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="RECORDS" FontSize="10" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="TotalRecordsText" Text="0" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═══════════ MAIN CONTENT ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════ LEFT COLUMN ═══════ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Connected Gateways -->
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="CONNECTED GATEWAYS" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <Border Background="{StaticResource Accent}" CornerRadius="8" Padding="8,2"
                                        HorizontalAlignment="Right">
                                    <TextBlock x:Name="GwCountBadge" Text="0 ACTIVE" FontSize="10" 
                                               FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </DockPanel>
                            <DataGrid x:Name="GatewayGrid" Style="{StaticResource DarkDataGrid}"
                                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeader}"
                                      CellStyle="{StaticResource DarkDataGridCell}"
                                      RowStyle="{StaticResource DarkDataGridRow}"
                                      MaxHeight="150">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="IP:PORT" Binding="{Binding Endpoint}" Width="120"/>
                                    <DataGridTextColumn Header="SINCE" Binding="{Binding Since, StringFormat=HH:mm:ss}" Width="60"/>
                                    <DataGridTextColumn Header="MSGS" Binding="{Binding Messages}" Width="50"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Sensor Status -->
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="SENSOR STATES" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                            <DataGrid x:Name="SensorStatusGrid" Style="{StaticResource DarkDataGrid}"
                                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeader}"
                                      CellStyle="{StaticResource DarkDataGridCell}"
                                      RowStyle="{StaticResource DarkDataGridRow}"
                                      MaxHeight="150">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SENSOR" Binding="{Binding SensorId}" Width="70"/>
                                    <DataGridTemplateColumn Header="STATE" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="6,2"
                                                        Background="{Binding Estado, Converter={StaticResource StateToColorConverter}}">
                                                    <TextBlock Text="{Binding Estado}" FontSize="10" FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="UPDATED" Binding="{Binding Timestamp}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Storage Files -->
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="STORAGE FILES" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="FilesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="📊" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}" 
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Info}" FontSize="10" 
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="↓ EXPORT" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Cursor="Hand"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════ RIGHT COLUMN ═══════ -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Data Explorer -->
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="DATA EXPLORER" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </DockPanel>

                            <!-- Filters + Export -->
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                    <ComboBox x:Name="CmbFilterType" Style="{StaticResource ComboBoxStyle}" Width="100">
                                        <ComboBoxItem Content="TYPE: ALL" IsSelected="True"/>
                                        <ComboBoxItem Content="TEMP"/>
                                        <ComboBoxItem Content="HUM"/>
                                        <ComboBoxItem Content="AR"/>
                                        <ComboBoxItem Content="RUIDO"/>
                                        <ComboBoxItem Content="PM2.5"/>
                                        <ComboBoxItem Content="PM10"/>
                                        <ComboBoxItem Content="LUZ"/>
                                        <ComboBoxItem Content="VIDEO"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                    <ComboBox x:Name="CmbFilterZona" Style="{StaticResource ComboBoxStyle}" Width="140">
                                        <ComboBoxItem Content="ZONE: ALL" IsSelected="True"/>
                                        <ComboBoxItem Content="ZONA_CENTRO"/>
                                        <ComboBoxItem Content="ZONA_ESCOLAR"/>
                                        <ComboBoxItem Content="ZONA_INDUSTRIAL"/>
                                        <ComboBoxItem Content="ZONA_RESIDENCIAL"/>
                                        <ComboBoxItem Content="ZONA_PARQUE"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                    <ComboBox x:Name="CmbFilterSensor" Style="{StaticResource ComboBoxStyle}" Width="100">
                                        <ComboBoxItem Content="SENSOR: ALL" IsSelected="True"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button Content="FILTER" Style="{StaticResource PrimaryButton}" Padding="16,8"
                                        Click="BtnFilter_Click" Margin="0,0,8,0"/>
                                <Button Content="⬇ EXPORTAR CSV" Style="{StaticResource OutlineButton}"
                                        Padding="16,8" Click="BtnExportCsv_Click"/>
                            </WrapPanel>

                            <!-- Data Grid -->
                            <DataGrid x:Name="DataExplorerGrid" DockPanel.Dock="Top" 
                                      Style="{StaticResource DarkDataGrid}"
                                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeader}"
                                      CellStyle="{StaticResource DarkDataGridCell}"
                                      RowStyle="{StaticResource DarkDataGridRow}"
                                      MaxHeight="280">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SENSOR" Binding="{Binding SensorId}" Width="70"/>
                                    <DataGridTextColumn Header="ZONE" Binding="{Binding Zona}" Width="*"/>
                                    <DataGridTemplateColumn Header="TYPE" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2"
                                                        Background="{Binding Tipo, Converter={StaticResource DataTypeToColorConverter}}">
                                                    <TextBlock Text="{Binding Tipo}" FontSize="10" FontWeight="Bold"
                                                               Foreground="White" HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="VALUE" Binding="{Binding Valor}" Width="80"/>
                                    <DataGridTextColumn Header="TIMESTAMP" Binding="{Binding Timestamp}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Pagination -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                                <TextBlock x:Name="PageInfoText" Text="SHOWING 0 RECORDS" FontSize="10"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnPrevPage" Content="‹" Style="{StaticResource OutlineButton}"
                                            Padding="8,4" FontSize="14" Margin="0,0,4,0" Click="BtnPrevPage_Click"/>
                                    <Border Background="{StaticResource Accent}" CornerRadius="4" Padding="8,4">
                                        <TextBlock x:Name="PageNumText" Text="1" FontSize="12" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                    <Button x:Name="BtnNextPage" Content="›" Style="{StaticResource OutlineButton}"
                                            Padding="8,4" FontSize="14" Margin="4,0,0,0" Click="BtnNextPage_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════ SERVER LOG ═══════════ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,4,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="📋  SERVER ACTIVITY LOG" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Success}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="INCOMING" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,12,0"/>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="OUTBOUND" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </DockPanel>
                <RichTextBox x:Name="ServerLog" Style="{StaticResource LogBox}" MaxHeight="160">
                    <FlowDocument x:Name="ServerLogDoc"/>
                </RichTextBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
