<UserControl x:Class="OneHealthMonitor.Views.SensorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgApp}">

    <Grid Margin="12">
        <TabControl x:Name="SensorTabs" Style="{StaticResource DarkTabControl}" 
                    Background="Transparent" BorderThickness="0">
            <!-- Programmatically added tabs go here -->
            
            <TabItem x:Name="AddTab" Header="➕ NOVO SENSOR" Style="{StaticResource DarkTabItem}" 
                     Selector.Selected="AddTab_Selected">
                <Grid>
                    <!-- Loading placeholder -->
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
