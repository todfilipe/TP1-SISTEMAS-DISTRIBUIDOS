<UserControl x:Class="OneHealthMonitor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgApp}">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!--  TOP BAR                                    -->
        <!-- ═══════════════════════════════════════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="SYSTEM DASHBOARD" FontSize="20" FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimary}"/>
                <Border x:Name="SystemBadge" Background="{StaticResource Success}" CornerRadius="10" 
                        Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SystemStatusText" Text="SYSTEM ONLINE" FontSize="11" 
                                   FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ClockText" Text="00:00:00" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- ═══════════════════════════════════════════ -->
        <!--  MAIN GRID: 3 columns                      -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════ COL 1 — METRIC CARDS ═══════ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Active Sensors -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="ACTIVE SENSORS" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextSecondary}" 
                                          />
                                <TextBlock x:Name="ActiveSensorsCount" Text="0" FontSize="36" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}" Margin="0,4,0,4"/>
                                <TextBlock x:Name="SensorSummaryText" Text="0 ONLINE · 0 MAINTENANCE · 0 DISABLED" 
                                           FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <TextBlock Text="📡" FontSize="32" Opacity="0.3" HorizontalAlignment="Right" 
                                       VerticalAlignment="Top" Foreground="{StaticResource Accent}"/>
                        </Grid>
                    </Border>

                    <!-- Gateways -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="GATEWAYS" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="GatewayCount" Text="0" FontSize="36" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" Margin="0,4,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="GatewayDot" Width="8" Height="8" Fill="{StaticResource Danger}" 
                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GatewayStatusText" Text="GW01 — DESLIGADO" FontSize="11"
                                               Foreground="{StaticResource Success}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="🔀" FontSize="32" Opacity="0.3" HorizontalAlignment="Right" 
                                       VerticalAlignment="Top" Foreground="{StaticResource Accent}"/>
                        </Grid>
                    </Border>

                    <!-- Messages Today -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="MESSAGES TODAY" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="MessageCount" Text="0" FontSize="36" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Text="📨" FontSize="32" Opacity="0.3" HorizontalAlignment="Right" 
                                       VerticalAlignment="Top" Foreground="{StaticResource Accent}"/>
                        </Grid>
                    </Border>

                    <!-- Buffer Status -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="BUFFER STATUS" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="BufferPercent" Text="0%" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}" 
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ProgressBar x:Name="BufferBar" Style="{StaticResource BufferProgressBar}" 
                                         Value="0" Margin="0,8,0,4"/>
                            <TextBlock x:Name="BufferText" Text="0 QUEUED MESSAGES / 1000 CAP" 
                                       FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════ COL 2 — LIVE DATA FEED ═══════ -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="LIVE DATA FEED" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <Border x:Name="LiveBadge" Background="#EF5350" CornerRadius="8" 
                                Padding="8,3" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="White" Margin="0,0,4,0"/>
                                <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <StackPanel/>
                    </DockPanel>

                    <ListView x:Name="LiveFeedList" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Color bar -->
                                    <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,2">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding Cor}"/>
                                        </Border.Background>
                                    </Border>

                                    <!-- Sensor ID badge -->
                                    <Border Grid.Column="1" Background="{StaticResource BgInput}" 
                                            CornerRadius="4" Padding="6,2" Margin="8,0">
                                        <TextBlock Text="{Binding SensorId}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </Border>

                                    <!-- Type badge -->
                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                            Background="{Binding Tipo, Converter={StaticResource DataTypeToColorConverter}}">
                                        <TextBlock Text="{Binding Tipo}" FontSize="10" FontWeight="Bold" 
                                                   Foreground="White"/>
                                    </Border>

                                    <!-- Value + Unit -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Valor}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Unidade}" FontSize="11" 
                                                   Foreground="{StaticResource TextSecondary}" Margin="3,3,0,0"/>
                                    </StackPanel>

                                    <!-- Zona -->
                                    <TextBlock Grid.Column="4" Text="{Binding Zona}" FontSize="10"
                                               Foreground="{StaticResource TextSecondary}" 
                                               VerticalAlignment="Center" Margin="8,0"/>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="5" Text="{Binding Timestamp}" FontSize="9"
                                               Foreground="{StaticResource TextSecondary}" 
                                               VerticalAlignment="Center" Opacity="0.7"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- ═══════ COL 3 — SENSOR STATUS GRID ═══════ -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="SENSOR STATUS" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <Button Content="↺ Refresh" Style="{StaticResource OutlineButton}" 
                                Padding="8,4" FontSize="10" HorizontalAlignment="Right"
                                Click="RefreshSensors_Click"/>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SensorStatusList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgInput}" CornerRadius="6" 
                                            Padding="12,10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding SensorId}" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimary}"/>
                                                <Border CornerRadius="8" Padding="8,2" HorizontalAlignment="Right"
                                                        Background="{Binding Estado, Converter={StaticResource StateToColorConverter}}">
                                                    <TextBlock Text="{Binding Estado}" FontSize="10" FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Zona}" FontSize="11" 
                                                       Foreground="{StaticResource TextSecondary}" Margin="0,4,0,4"/>
                                            <ItemsControl ItemsSource="{Binding TiposDados}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource BgCard}" CornerRadius="4"
                                                                Padding="6,2" Margin="0,0,4,0">
                                                            <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextSecondary}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!--  BOTTOM BAR                                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}" CornerRadius="8" 
                Padding="8" Margin="0,12,0,0">
            <UniformGrid Columns="4">
                <Button Content="⊕  CONNECT SENSOR" Style="{StaticResource PrimaryButton}" 
                        Margin="4,0" Click="BtnConnectSensor_Click"/>
                <Button Content="📊  SEND DATA" Style="{StaticResource OutlineButton}" 
                        Margin="4,0" Click="BtnSendData_Click"/>
                <Button Content="⚡  HEARTBEAT ALL" Style="{StaticResource OutlineButton}" 
                        Margin="4,0" Click="BtnHeartbeat_Click"/>
                <Button Content="⛔  EMERGENCY STOP" Style="{StaticResource DangerButton}" 
                        Margin="4,0" Click="BtnEmergencyStop_Click"/>
            </UniformGrid>
        </Border>
    </Grid>
</UserControl>
